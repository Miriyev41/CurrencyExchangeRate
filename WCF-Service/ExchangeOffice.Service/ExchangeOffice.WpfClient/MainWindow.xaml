<Window x:Class="ExchangeOffice.WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Global Currency Exchange Terminal" Height="750" Width="800" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,20,0">

            <TextBlock Text="FUND ACCOUNT (TOP-UP)" FontSize="18" FontWeight="Bold" Foreground="#FF28A745" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,5,10">
                    <TextBlock Text="Currency (e.g. PLN):" Foreground="Gray" FontWeight="Bold"/>
                    <TextBox x:Name="txtTopUpCurrency" Height="30" FontSize="16" CharacterCasing="Upper" Padding="2" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,0,0,10">
                    <TextBlock Text="Amount:" Foreground="Gray" FontWeight="Bold"/>
                    <TextBox x:Name="txtTopUpAmount" Height="30" FontSize="16" Padding="2" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Row="1" Grid.ColumnSpan="2" x:Name="btnTopUp" Content="DEPOSIT FUNDS" Height="35" Background="#FF28A745" Foreground="White" FontWeight="Bold" FontSize="14" Click="btnTopUp_Click" Cursor="Hand"/>
            </Grid>

            <TextBlock Text="EXECUTE TRADE" FontSize="18" FontWeight="Bold" Foreground="#FF0078D7" Margin="0,0,0,10"/>
            <TextBlock Text="Currency to SELL (e.g. PLN):" Foreground="Gray" FontWeight="Bold"/>
            <TextBox x:Name="txtFromCurrency" Margin="0,5,0,15" Height="30" FontSize="16" CharacterCasing="Upper" Padding="2" TextChanged="txtFromCurrency_TextChanged"/>
            <TextBlock Text="Currency to BUY (e.g. USD):" Foreground="Gray" FontWeight="Bold"/>
            <TextBox x:Name="txtToCurrency" Margin="0,5,0,15" Height="30" FontSize="16" CharacterCasing="Upper" Padding="2"/>
            <TextBlock Text="Amount to Exchange:" Foreground="Gray" FontWeight="Bold"/>
            <TextBox x:Name="txtAmount" Margin="0,5,0,20" Height="30" FontSize="16" Padding="2"/>
            <Button x:Name="btnExchange" Content="AUTHORIZE TRANSACTION" Height="45" Background="#FF0078D7" Foreground="White" FontWeight="Bold" FontSize="14" Click="btnExchange_Click" Cursor="Hand"/>
            <TextBlock Text="System Output:" Margin="0,20,0,5" FontWeight="Bold" Foreground="Gray"/>
            <TextBlock x:Name="txtResult" Text="System Ready." Foreground="#FF333333" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold"/>

            <TextBlock Text="MARKET RESEARCH (HISTORICAL)" FontSize="18" FontWeight="Bold" Foreground="#FF6C757D" Margin="0,30,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtHistoryCurrency" Grid.Column="0" Margin="0,0,5,0" Height="30" FontSize="16" CharacterCasing="Upper" Padding="2" ToolTip="Currency"/>
                <DatePicker x:Name="dpHistoryDate" Grid.Column="1" Margin="5,0,10,0" Height="30" FontSize="16"/>
                <Button x:Name="btnCheckHistory" Grid.Column="2" Content="CHECK ARCHIVE" Width="130" Height="30" Background="#FF6C757D" Foreground="White" FontWeight="Bold" Click="btnCheckHistory_Click" Cursor="Hand"/>
            </Grid>
            <TextBlock x:Name="txtHistoryResult" Text="Select a currency and a past date." Margin="0,5,0,0" Foreground="#FF333333" FontStyle="Italic" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <TextBlock Text="BALANCES" FontSize="16" FontWeight="Bold" Foreground="#FF0078D7" Margin="0,0,0,10"/>
            <ListBox x:Name="lstWallets" Height="150" Margin="0,0,0,20" FontSize="14" Background="#FFF5F5F5" Padding="5"/>
            <TextBlock Text="TRANSACTION HISTORY" FontSize="16" FontWeight="Bold" Foreground="#FF0078D7" Margin="0,0,0,10"/>
            <ListBox x:Name="lstHistory" Height="350" FontSize="12" FontFamily="Consolas" Background="#FFF5F5F5" Padding="5" SelectionChanged="lstHistory_SelectionChanged"/>
        </StackPanel>
    </Grid>
</Window>