<Window x:Class="ExchangeOffice.WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Global Currency Exchange Terminal" Height="500" Width="800" Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="EXECUTE TRADE" FontSize="20" FontWeight="Bold" Foreground="#FF0078D7" Margin="0,0,0,20"/>

            <TextBlock Text="Currency to SELL (e.g. PLN):" Foreground="Gray" FontWeight="Bold"/>
            <TextBox x:Name="txtFromCurrency" Margin="0,5,0,15" Height="30" FontSize="16" CharacterCasing="Upper" Padding="2"/>

            <TextBlock Text="Currency to BUY (e.g. USD):" Foreground="Gray" FontWeight="Bold"/>
            <TextBox x:Name="txtToCurrency" Margin="0,5,0,15" Height="30" FontSize="16" CharacterCasing="Upper" Padding="2"/>

            <TextBlock Text="Amount to Exchange:" Foreground="Gray" FontWeight="Bold"/>
            <TextBox x:Name="txtAmount" Margin="0,5,0,20" Height="30" FontSize="16" Padding="2"/>

            <Button x:Name="btnExchange" Content="AUTHORIZE TRANSACTION" Height="45" Background="#FF0078D7" Foreground="White" FontWeight="Bold" FontSize="14" Click="btnExchange_Click" Cursor="Hand"/>

            <TextBlock Text="System Output:" Margin="0,20,0,5" FontWeight="Bold" Foreground="Gray"/>
            <TextBlock x:Name="txtResult" Text="System Ready." Foreground="#FF333333" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <TextBlock Text="PORTFOLIO BALANCES" FontSize="16" FontWeight="Bold" Foreground="#FF0078D7" Margin="0,0,0,10"/>
            <ListBox x:Name="lstWallets" Height="120" Margin="0,0,0,20" FontSize="14" Background="#FFF5F5F5" Padding="5"/>

            <TextBlock Text="TRANSACTION LEDGER" FontSize="16" FontWeight="Bold" Foreground="#FF0078D7" Margin="0,0,0,10"/>
            <ListBox x:Name="lstHistory" Height="200" FontSize="12" FontFamily="Consolas" Background="#FFF5F5F5" Padding="5"/>
        </StackPanel>
    </Grid>
</Window>